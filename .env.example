# ローカルでビルドするときの設定例（.env にコピーして使います）。
# Cloudflare Pages では、プロジェクトの「設定 → 環境変数」に同じ名前で登録してください。

# 公開するサイトのURL（末尾スラッシュなし）。canonical / OGP / sitemap.xml に使われます。
SITE_URL=https://smilewise.pages.dev

# お問い合わせフォームの送信先（Formspree のフォームURL）。
# 未設定の場合、フォームは「テストモード」で動作し、メールは届きません。
VITE_FORM_ENDPOINT=https://formspree.io/f/mbgdpdvq

# Cloudflare Pages のビルドで使う Node.js のバージョン
NODE_VERSION=22
